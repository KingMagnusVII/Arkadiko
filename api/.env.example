# FastAPI bind settings. The README's uvicorn command currently supplies
# host and port explicitly; main.py reads the OpenClaw/task settings below.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
# Generate this separately with the PowerShell command in README.md.
BRIDGE_API_TOKEN=replace-with-a-long-random-bridge-token

# Generate/retrieve with OpenClaw CLI; do not reuse BRIDGE_API_TOKEN.
OPENCLAW_GATEWAY_TOKEN=replace-with-your-openclaw-gateway-token

# Match the port shown by `openclaw gateway status` (default: 18789).
OPENCLAW_GATEWAY_PORT=18789

# Run the Gateway-backed OpenClaw agent CLI and capture its JSON result.
# Keep these paths aligned with the installed OpenClaw version on this PC.
OPENCLAW_COMMAND=node
OPENCLAW_ENTRYPOINT=C:\Program Files\WindowsApps\OpenClawFoundation.OpenClawGateway_2026.10.600.0_x64__rfcbke2p71se2\app\openclaw.mjs
OPENCLAW_AGENT_ID=main
OPENCLAW_WORKSPACE=C:\Magnus\Code\DSA
OPENCLAW_TIMEOUT_SECONDS=300
