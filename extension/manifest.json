{
  "manifest_version": 3,
  "name": "OpenClaw ChatGPT Bridge",
  "version": "0.1.0",
  "description": "Manually hand off a structured task from ChatGPT to your local OpenClaw bridge.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "OpenClaw Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
