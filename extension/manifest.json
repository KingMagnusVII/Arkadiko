{
  "manifest_version": 3,
  "name": "Arkadiko — ChatGPT to OpenClaw",
  "version": "0.3.0",
  "description": "A user-armed local handoff between ChatGPT and OpenClaw.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Arkadiko Bridge",
    "default_popup": "popup.html"
  }
}
