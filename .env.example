# Copy to .env locally. Never commit real secrets.
# This root template includes optional n8n settings and legacy bridge defaults.
# The API-specific settings used by this branch are in api/.env.example.
N8N_ENCRYPTION_KEY=replace-with-a-random-32-byte-or-longer-secret
N8N_BASIC_AUTH_ACTIVE=false
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# Local bridge API
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
BRIDGE_API_TOKEN=replace-with-a-long-random-token
OPENCLAW_COMMAND=openclaw
OPENCLAW_AGENT_ID=main
OPENCLAW_WORKSPACE=C:\\Magnus\\Code\\DSA
OPENCLAW_TIMEOUT_SECONDS=300

# n8n can reach the Windows host using host.docker.internal.
# The bridge itself should remain loopback-only unless you deliberately
# configure a narrowly-scoped firewall rule for container-to-host traffic.
